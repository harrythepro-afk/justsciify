# JustSciify - Environment Configurations Example
# Copy this file to .env.local and configure the secrets appropriately.

# MongoDB Connection String (must have a valid replicaSet and credentials if using Atlas)
MONGODB_URI=mongodb://username:password@hostname:port/database_name

# JSON Web Token Secret Key for signing session cookies
JWT_SECRET=your_super_secure_jwt_secret_key_here

# Optional: Groq Cloud API Key for Llama-based AI Question Generation
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenAI API Key for ChatGPT-based AI Question Generation
OPENAI_API_KEY=your_openai_api_key_here
